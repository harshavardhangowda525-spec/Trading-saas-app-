# ─────────────────────────────────────────────────────────────────
# ChartSense environment. Copy to .env and fill in.
# Validated at startup by src/server/env.schema.ts (the app refuses to boot
# if something required is missing or malformed).
# ─────────────────────────────────────────────────────────────────

# ── Core (required from M1) ──────────────────────────────────────
# Pooled connection used by the app.
DATABASE_URL="postgresql://chartsense:chartsense@localhost:5432/chartsense"
# Direct (non-pooled) connection used by migrations. Needed on Neon; optional locally.
DIRECT_URL=
# Generate with: npx auth secret   (min 32 chars)
AUTH_SECRET=
# Public URL of the site. Local only: on Render leave it unset (RENDER_EXTERNAL_URL is
# used). Also used as AUTH_URL, so don't set AUTH_URL / NEXTAUTH_URL separately.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# development | preview | production. Falls back to VERCEL_ENV on Vercel.
APP_ENV=development
# Random string used to hash IPs on terms acceptance.
IP_HASH_SALT=
# Comma-separated emails promoted to ADMIN on sign-in.
ADMIN_EMAILS=

# ── Auth: Google (optional; button hidden when unset) ────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Auth: email magic link ───────────────────────────────────────
# "console" prints magic links in the server log (default locally, blocked in production).
# "resend" sends real email (default on deployed environments).
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="ChartSense <login@yourdomain.com>"

# ── Credits & feature flags ──────────────────────────────────────
FREE_SIGNUP_CREDITS=1
FEATURE_FREE_CREDIT=true
FEATURE_SHARE_LINKS=true
# KEEP false in production until SEBI RA compliance is confirmed.
FEATURE_TRADE_LEVELS=false

# ── M2: storage (S3-compatible; Cloudflare R2 in staging/production) ──
# Local defaults below match the `s3` service in docker-compose.yml.
# R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
# All five must be set together; leave all empty to disable uploads.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION=us-east-1
S3_BUCKET=chartsense-dev
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# true for local emulators; R2/AWS work with false.
S3_FORCE_PATH_STYLE=true
# Lifetime of image links shown to users.
SIGNED_URL_TTL_SECONDS=300

# ── M3: AI + rate limiting ───────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL_ANALYSIS=
AI_MODEL_READABILITY=
AI_TIMEOUT_MS=45000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── M5: payments ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── M6–M8: ops ───────────────────────────────────────────────────
CRON_SECRET=
SENTRY_DSN=
